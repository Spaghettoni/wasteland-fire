[layer_names]

3d_physics/layer_1="map"
3d_physics/layer_2="units"
3d_physics/layer_3="zones"
3d_physics/layer_4="flags"
3d_physics/layer_5="gyrocopters"
3d_physics/layer_6="cliffs_water"
3d_physics/layer_7="cover"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

renderer/rendering_method="forward_plus"
