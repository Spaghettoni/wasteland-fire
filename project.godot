[layer_names]

3d_physics/layer_1="map"
3d_physics/layer_2="units"
3d_physics/layer_3="zones"
3d_physics/layer_4="flags"
3d_physics/layer_5="gyrocopters"
3d_physics/layer_6="cliffs_water"
3d_physics/layer_7="cover"
3d_physics/layer_8="sight"
3d_physics/layer_9="smoke"
3d_render/layer_2="tower_top"
3d_render/layer_3="silhouette_p1"
3d_render/layer_4="silhouette_p2"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[shader_globals]

